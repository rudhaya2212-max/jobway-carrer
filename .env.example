# JOB WAY AI - Environment Configuration Example

# Backend Server Port
PORT=5000

# Google Gemini API Key (Backend service only - keep secure)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Optional for cloud DB persistence)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Environment Mode
NODE_ENV=development

